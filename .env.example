# Public: safe in the browser.
# Supabase project URL. Locally, `supabase status` prints it (http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable (anon) key. Locally, `supabase status` prints it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Set to true to show the "Demo environment · fictional data" banner.
NEXT_PUBLIC_DEMO=true

# Server only: never prefix these with NEXT_PUBLIC_.
# Supabase service-role key. Bypasses row-level security; used only from lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Signs the session-limit cookies (docs/SECURITY.md, S-31). Random, 32 characters or more:
# `openssl rand -base64 48`. Changing it signs everyone out.
SESSION_COOKIE_SECRET=replace-with-a-random-secret
# Resend API key, used only from lib/email/send.ts.
RESEND_API_KEY=replace-with-resend-api-key
# Sender on the domain verified in Resend (Domains). Use a no-reply address on that domain.
EMAIL_FROM="The Schoeman Clinic <no-reply@schoemanclinic.systemizedtoscale.com>"
# The site's public address, with no trailing slash. Links and the logo in emails use it.
SITE_URL=https://schoemanclinic.systemizedtoscale.com
# Google Calendar for staff (Google Cloud Console: OAuth client, type Web application).
# Redirect URI to register there: <SITE_URL>/api/google/callback. SITE_URL above is required too.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Encrypts each staff member's Google token before it is stored. 32 random bytes, base64:
# `openssl rand -base64 32`. Changing it disconnects everyone's calendar.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
# Optional. Only Google accounts in this Workspace domain can connect, e.g. theschoemanclinic.com.
# GOOGLE_WORKSPACE_DOMAIN=
# GoHighLevel: patient messages by email and WhatsApp. Leave out to send email through Resend only.
# Private Integration token (scopes: contacts.write, conversations/message.write) and the sub-account id.
# WhatsApp goes out as a GoHighLevel text message, which the clinic's plug-in diverts to WhatsApp.
# GHL_PRIVATE_TOKEN=
# GHL_LOCATION_ID=
# Call recording transcription: AssemblyAI, EU region (replaces Fathom). Leave out to hide recording.
# ASSEMBLYAI_API_KEY=
# A random secret AssemblyAI sends back with each transcript: `openssl rand -base64 48`.
# TRANSCRIPTION_WEBHOOK_SECRET=
# Optional. Who is emailed when a doctor or admin is invited (live site only). Defaults to Dr Gina Schoeman.
# TEAM_INVITE_ALERT_TO=drgina@theschoemanclinic.com
# Daily job that withdraws a leaver's Google Calendar access at Google (vercel.json). At least 32
# characters: `openssl rand -base64 48`. Vercel Cron sends it; without it the job does nothing.
# CRON_SECRET=
# Stripe: the £30 repeat prescription fee. Leave out to take requests without online payment.
# Secret key from Developers > API keys (sk_test_ while testing). Add a webhook endpoint
# <SITE_URL>/api/stripe/webhook for checkout.session.completed and
# checkout.session.async_payment_succeeded, and put its signing secret here.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SignatureRx: prescriptions sent from a repeat request. Leave out to hide the connection.
# The OAuth client id and secret from the clinic's SignatureRx account (client credentials), and which
# server to use: https://stage-srx.signaturerx.co.uk while testing, https://app.signaturerx.co.uk when live.
# Keep the id and secret in the password manager; never commit them. `pnpm srx:check` tests them.
# SIGNATURERX_CLIENT_ID=
# SIGNATURERX_CLIENT_SECRET=
# SIGNATURERX_BASE_URL=https://stage-srx.signaturerx.co.uk
# Set to true to show the form where a doctor types their signing PIN, which is passed straight to
# SignatureRx and never stored or logged. Off until the security review of that form is done.
# SIGNATURERX_SIGNING_ENABLED=false
# Optional. Who is emailed, with no details, when a repeat prescription is paid for. Defaults to the clinic inbox.
# PRESCRIPTIONS_ALERT_TO=info@theschoemanclinic.com
# Optional. Who is emailed, with no details, when a patient asks a question. Defaults to the clinic inbox.
# QUESTIONS_ALERT_TO=info@theschoemanclinic.com
# Optional. Where replies go. Leave it out if nobody reads replies.
# EMAIL_REPLY_TO=clinic@example.test
