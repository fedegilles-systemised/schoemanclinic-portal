    "react-dom": "^19.0.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
